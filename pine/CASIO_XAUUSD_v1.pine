//@version=6
strategy("CASIO XAUUSD v1 — Intraday + Scalping", overlay=true, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=1, max_labels_count=500)

// CASIO TradingView-first interface.
// Mirrors the deterministic rules in casio/config.py + casio/strategy.py.
// Recommended chart: XAUUSD, 15 minute.

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
groupMode = "Mode"
modeInput = input.string("AUTO", "Strategy mode", options=["AUTO", "INTRADAY", "SCALPING"], group=groupMode)
showDashboard = input.bool(true, "Show CASIO dashboard", group=groupMode)
showLevels = input.bool(true, "Show stop/target", group=groupMode)

// Keep defaults in sync with casio/config.py.
groupIntraday = "Intraday"
intradayMinScore = input.int(70, "Minimum score", minval=0, maxval=100, group=groupIntraday)
intradayRR = input.float(3.0, "Target R:R", minval=0.5, step=0.1, group=groupIntraday)
maxAtrPct = input.float(0.012, "Maximum ATR / price", minval=0.001, step=0.001, group=groupIntraday)

groupScalp = "Scalping / Sideways"
scalpMinScore = input.int(68, "Minimum score", minval=0, maxval=100, group=groupScalp)
scalpRR = input.float(1.5, "Target R:R", minval=0.5, step=0.1, group=groupScalp)
maxAdx = input.float(22.0, "Maximum ADX", minval=1, step=0.5, group=groupScalp)
maxRangeAtr = input.float(5.5, "Maximum 30-bar range / ATR", minval=1, step=0.1, group=groupScalp)
edgeFraction = input.float(0.22, "Range-edge fraction", minval=0.05, maxval=0.45, step=0.01, group=groupScalp)

groupAudit = "Rolling Audit"
auditWindow = input.int(100, "Trades in rolling audit", minval=30, maxval=100, group=groupAudit)
minAuditTrades = input.int(30, "Minimum trades before audit", minval=10, maxval=100, group=groupAudit)
warnWinRateDrop = input.float(8.0, "Warning: win-rate drop (pp)", minval=1, step=0.5, group=groupAudit)
warnExpectancyDrop = input.float(0.20, "Warning: expectancy drop (R)", minval=0.05, step=0.05, group=groupAudit)
criticalPF = input.float(1.0, "Critical: profit factor below", minval=0.1, step=0.1, group=groupAudit)

groupAlert = "Webhook"
sendWebhookAlerts = input.bool(true, "Emit alert() JSON", group=groupAlert)

// ─────────────────────────────────────────────────────────────────────────────
// Features — mirrors casio/strategy.py
// ─────────────────────────────────────────────────────────────────────────────
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
atr14 = ta.atr(14)
[plusDI, minusDI, adx14] = ta.dmi(14, 14)

hh20 = ta.highest(high[1], 20)
ll20 = ta.lowest(low[1], 20)
rangeHigh30 = ta.highest(high[1], 30)
rangeLow30 = ta.lowest(low[1], 30)
rangeSize30 = rangeHigh30 - rangeLow30
rangeAtr = atr14 > 0 ? rangeSize30 / atr14 : na

hasHistory = not na(ema50) and not na(atr14) and not na(adx14) and not na(rangeHigh30) and not na(rangeLow30)
sideways = hasHistory and adx14 <= maxAdx and rangeAtr <= maxRangeAtr

autoMode = sideways ? "SCALPING" : "INTRADAY"
activeMode = modeInput == "AUTO" ? autoMode : modeInput

// ─────────────────────────────────────────────────────────────────────────────
// Intraday score
// trend 25 + sweep 25 + candle 15 + volatility 10 + alignment 10
// ─────────────────────────────────────────────────────────────────────────────
intradayScore = 0
intradayDirection = 0

bullishTrend = ema20 > ema50 and close > ema20
bearishTrend = ema20 < ema50 and close < ema20

if bullishTrend
    intradayDirection := 1
    intradayScore += 25
else if bearishTrend
    intradayDirection := -1
    intradayScore += 25

sellSideSweep = intradayDirection == 1 and low < ll20 and close > ll20
buySideSweep = intradayDirection == -1 and high > hh20 and close < hh20

if sellSideSweep or buySideSweep
    intradayScore += 25

intradayConfirm = (intradayDirection == 1 and close > open) or (intradayDirection == -1 and close < open)
if intradayConfirm
    intradayScore += 15

atrPct = close != 0 ? atr14 / close : na
if not na(atrPct) and atrPct <= maxAtrPct
    intradayScore += 10

if intradayDirection != 0
    intradayScore += 10

intradayValid = hasHistory and activeMode == "INTRADAY" and intradayDirection != 0 and intradayScore >= intradayMinScore

// ─────────────────────────────────────────────────────────────────────────────
// Scalping score
// range edge 30 + edge sweep 25 + low ADX 20 + compression 10 + candle 10
// ─────────────────────────────────────────────────────────────────────────────
scalpScore = 0
scalpDirection = 0
rangePos = rangeSize30 > 0 ? (close - rangeLow30) / rangeSize30 : na

if not na(rangePos) and rangePos <= edgeFraction
    scalpDirection := 1
    scalpScore += 30
    if low < rangeLow30 and close > rangeLow30
        scalpScore += 25
else if not na(rangePos) and rangePos >= 1.0 - edgeFraction
    scalpDirection := -1
    scalpScore += 30
    if high > rangeHigh30 and close < rangeHigh30
        scalpScore += 25

if adx14 <= maxAdx
    scalpScore += 20
if rangeAtr <= maxRangeAtr
    scalpScore += 10

scalpConfirm = (scalpDirection == 1 and close > open) or (scalpDirection == -1 and close < open)
if scalpConfirm
    scalpScore += 10

scalpValid = hasHistory and activeMode == "SCALPING" and sideways and scalpDirection != 0 and scalpScore >= scalpMinScore

// ─────────────────────────────────────────────────────────────────────────────
// Signal + risk levels
// ─────────────────────────────────────────────────────────────────────────────
signalValid = intradayValid or scalpValid
signalDirection = intradayValid ? intradayDirection : scalpValid ? scalpDirection : 0
signalScore = intradayValid ? intradayScore : scalpValid ? scalpScore : activeMode == "INTRADAY" ? intradayScore : scalpScore
signalRR = intradayValid ? intradayRR : scalpValid ? scalpRR : na
stopDistance = intradayValid ? math.max(atr14 * 1.1, syminfo.mintick) : scalpValid ? math.max(atr14 * 0.8, syminfo.mintick) : na
signalEntry = signalValid ? close : na
signalStop = signalDirection == 1 ? signalEntry - stopDistance : signalDirection == -1 ? signalEntry + stopDistance : na
signalTarget = signalDirection == 1 ? signalEntry + stopDistance * signalRR : signalDirection == -1 ? signalEntry - stopDistance * signalRR : na

canEnter = barstate.isconfirmed and signalValid and strategy.position_size == 0

var float liveEntry = na
var float liveStop = na
var float liveTarget = na
var float liveRiskDistance = na
var int liveDirection = 0
var string liveMode = "NONE"

if canEnter
    liveEntry := signalEntry
    liveStop := signalStop
    liveTarget := signalTarget
    liveRiskDistance := stopDistance
    liveDirection := signalDirection
    liveMode := activeMode
    if signalDirection == 1
        strategy.entry("CASIO-L", strategy.long)
        strategy.exit("CASIO-L-X", "CASIO-L", stop=liveStop, limit=liveTarget)
    else
        strategy.entry("CASIO-S", strategy.short)
        strategy.exit("CASIO-S-X", "CASIO-S", stop=liveStop, limit=liveTarget)

if strategy.position_size > 0 and not na(liveStop) and not na(liveTarget)
    strategy.exit("CASIO-L-X", "CASIO-L", stop=liveStop, limit=liveTarget)
if strategy.position_size < 0 and not na(liveStop) and not na(liveTarget)
    strategy.exit("CASIO-S-X", "CASIO-S", stop=liveStop, limit=liveTarget)

// ─────────────────────────────────────────────────────────────────────────────
// Rolling closed-trade history in R
// Keeps the latest 200 so the current 100 can be compared with the previous 100.
// ─────────────────────────────────────────────────────────────────────────────
var float[] rHistory = array.new_float()
var string[] modeHistory = array.new_string()

newClosedTrade = strategy.closedtrades > nz(strategy.closedtrades[1])
if newClosedTrade and not na(liveEntry) and not na(liveRiskDistance) and liveRiskDistance > 0 and liveDirection != 0
    lastTradeIndex = strategy.closedtrades - 1
    closedExit = strategy.closedtrades.exit_price(lastTradeIndex)
    tradeR = liveDirection == 1 ? (closedExit - liveEntry) / liveRiskDistance : (liveEntry - closedExit) / liveRiskDistance
    array.push(rHistory, tradeR)
    array.push(modeHistory, liveMode)
    if array.size(rHistory) > 200
        array.shift(rHistory)
        array.shift(modeHistory)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    liveEntry := na
    liveStop := na
    liveTarget := na
    liveRiskDistance := na
    liveDirection := 0
    liveMode := "NONE"

// ─────────────────────────────────────────────────────────────────────────────
// Rolling audit helpers
// ─────────────────────────────────────────────────────────────────────────────
f_window_metrics(float[] values, int fromIndex, int toIndex) =>
    int count = 0
    int wins = 0
    float sumR = 0.0
    float grossWin = 0.0
    float grossLoss = 0.0
    float equityR = 0.0
    float peakR = 0.0
    float maxDrawdownR = 0.0
    if fromIndex >= 0 and toIndex >= fromIndex
        for i = fromIndex to toIndex
            r = array.get(values, i)
            count += 1
            sumR += r
            if r > 0
                wins += 1
                grossWin += r
            else if r < 0
                grossLoss += math.abs(r)
            equityR += r
            peakR := math.max(peakR, equityR)
            maxDrawdownR := math.max(maxDrawdownR, peakR - equityR)
    winRate = count > 0 ? wins * 100.0 / count : na
    expectancy = count > 0 ? sumR / count : na
    profitFactor = grossLoss > 0 ? grossWin / grossLoss : grossWin > 0 ? 999.0 : na
    [count, wins, winRate, expectancy, profitFactor, maxDrawdownR]

f_mode_winrate(float[] values, string[] modes, string wantedMode, int fromIndex, int toIndex) =>
    int count = 0
    int wins = 0
    if fromIndex >= 0 and toIndex >= fromIndex
        for i = fromIndex to toIndex
            if array.get(modes, i) == wantedMode
                count += 1
                if array.get(values, i) > 0
                    wins += 1
    count > 0 ? wins * 100.0 / count : na

historyCount = array.size(rHistory)
currentCountRequested = math.min(auditWindow, historyCount)
currentStart = historyCount - currentCountRequested
currentEnd = historyCount - 1
previousAvailable = math.max(0, historyCount - currentCountRequested)
previousCountRequested = math.min(auditWindow, previousAvailable)
previousStart = currentStart - previousCountRequested
previousEnd = currentStart - 1

[currTrades, currWins, currWinRate, currExpectancy, currPF, currMaxDD] = f_window_metrics(rHistory, currentStart, currentEnd)
[prevTrades, prevWins, prevWinRate, prevExpectancy, prevPF, prevMaxDD] = f_window_metrics(rHistory, previousStart, previousEnd)

intradayWinRate = f_mode_winrate(rHistory, modeHistory, "INTRADAY", currentStart, currentEnd)
scalpingWinRate = f_mode_winrate(rHistory, modeHistory, "SCALPING", currentStart, currentEnd)

winRateDelta = prevTrades >= minAuditTrades and not na(prevWinRate) and not na(currWinRate) ? currWinRate - prevWinRate : na
expectancyDelta = prevTrades >= minAuditTrades and not na(prevExpectancy) and not na(currExpectancy) ? currExpectancy - prevExpectancy : na

string auditStatus = "INSUFFICIENT"
if currTrades >= minAuditTrades
    critical = (not na(currPF) and currPF < criticalPF) or (not na(currExpectancy) and currExpectancy <= 0)
    warning = prevTrades >= minAuditTrades and ((not na(winRateDelta) and winRateDelta <= -warnWinRateDrop) or (not na(expectancyDelta) and expectancyDelta <= -warnExpectancyDrop))
    auditStatus := critical ? "CRITICAL" : warning ? "WARNING" : "HEALTHY"

// ─────────────────────────────────────────────────────────────────────────────
// JSON webhook payload
// ─────────────────────────────────────────────────────────────────────────────
f_num(v) => str.tostring(v, format.mintick)
f_dir(d) => d == 1 ? "long" : "short"
f_mode(m) => m == "INTRADAY" ? "intraday" : "scalping"

if canEnter and sendWebhookAlerts
    payload = "{" +
      "\"schema\":\"casio.tv.v1\"," +
      "\"event\":\"signal\"," +
      "\"symbol\":\"" + syminfo.tickerid + "\"," +
      "\"ticker\":\"" + syminfo.ticker + "\"," +
      "\"timeframe\":\"" + timeframe.period + "\"," +
      "\"bar_time\":" + str.tostring(time) + "," +
      "\"mode\":\"" + f_mode(activeMode) + "\"," +
      "\"direction\":\"" + f_dir(signalDirection) + "\"," +
      "\"score\":" + str.tostring(signalScore) + "," +
      "\"entry\":" + f_num(signalEntry) + "," +
      "\"stop\":" + f_num(signalStop) + "," +
      "\"target\":" + f_num(signalTarget) + "," +
      "\"rr\":" + str.tostring(signalRR) + "," +
      "\"adx\":" + str.tostring(adx14, "#.##") + "," +
      "\"atr\":" + f_num(atr14) +
      "}"
    alert(payload, alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// Visuals
// ─────────────────────────────────────────────────────────────────────────────
plot(ema20, "EMA 20", linewidth=1)
plot(ema50, "EMA 50", linewidth=1)
plot(activeMode == "SCALPING" ? rangeHigh30 : na, "Range high", style=plot.style_linebr)
plot(activeMode == "SCALPING" ? rangeLow30 : na, "Range low", style=plot.style_linebr)
plot(showLevels and strategy.position_size != 0 ? liveStop : na, "Live stop", style=plot.style_linebr, linewidth=2)
plot(showLevels and strategy.position_size != 0 ? liveTarget : na, "Live target", style=plot.style_linebr, linewidth=2)

plotshape(canEnter and signalDirection == 1, title="CASIO Long", text="CASIO\nLONG", style=shape.labelup, location=location.belowbar, size=size.tiny)
plotshape(canEnter and signalDirection == -1, title="CASIO Short", text="CASIO\nSHORT", style=shape.labeldown, location=location.abovebar, size=size.tiny)

bgcolor(activeMode == "SCALPING" ? color.new(color.orange, 92) : color.new(color.blue, 95), title="CASIO regime")

f_pct(v) => na(v) ? "—" : str.tostring(v, "#.0") + "%"
f_r(v) => na(v) ? "—" : str.tostring(v, "#.##") + "R"
f_pf(v) => na(v) ? "—" : v >= 999 ? "∞" : str.tostring(v, "#.##")
f_price(v) => na(v) ? "—" : str.tostring(v, format.mintick)

positionSignal = strategy.position_size > 0 ? "LONG • LIVE" : strategy.position_size < 0 ? "SHORT • LIVE" : signalValid ? (signalDirection == 1 ? "LONG" : "SHORT") : "WAIT"
displayEntry = strategy.position_size != 0 ? liveEntry : signalValid ? signalEntry : na
displayStop = strategy.position_size != 0 ? liveStop : signalValid ? signalStop : na
displayTarget = strategy.position_size != 0 ? liveTarget : signalValid ? signalTarget : na

signalBg = strategy.position_size > 0 or (signalValid and signalDirection == 1) ? color.new(color.green, 72) : strategy.position_size < 0 or (signalValid and signalDirection == -1) ? color.new(color.red, 72) : color.new(color.gray, 82)
auditBg = auditStatus == "HEALTHY" ? color.new(color.green, 72) : auditStatus == "WARNING" ? color.new(color.orange, 65) : auditStatus == "CRITICAL" ? color.new(color.red, 65) : color.new(color.gray, 82)
modeBg = activeMode == "SCALPING" ? color.new(color.orange, 75) : color.new(color.blue, 78)
panelBg = color.new(color.rgb(15, 18, 25), 8)
labelBg = color.new(color.rgb(29, 34, 45), 4)
headerBg = color.new(color.rgb(8, 10, 14), 0)

f_cell(tbl, col, row, txt, bg) =>
    table.cell(tbl, col, row, txt, text_color=color.white, bgcolor=bg, text_size=size.small)

var table dash = table.new(position.top_right, 2, 16, bgcolor=panelBg, frame_color=color.new(color.white, 55), frame_width=1, border_color=color.new(color.white, 82), border_width=1)
if barstate.islast
    if showDashboard
        f_cell(dash, 0, 0, "CASIO", headerBg)
        f_cell(dash, 1, 0, syminfo.ticker + " • " + timeframe.period, headerBg)
        f_cell(dash, 0, 1, "MODE", labelBg)
        f_cell(dash, 1, 1, activeMode, modeBg)
        f_cell(dash, 0, 2, "REGIME", labelBg)
        f_cell(dash, 1, 2, sideways ? "SIDEWAYS" : "DIRECTIONAL", panelBg)
        f_cell(dash, 0, 3, "ADX / SCORE", labelBg)
        f_cell(dash, 1, 3, str.tostring(adx14, "#.##") + " / " + str.tostring(signalScore), panelBg)
        f_cell(dash, 0, 4, "SIGNAL", labelBg)
        f_cell(dash, 1, 4, positionSignal, signalBg)
        f_cell(dash, 0, 5, "ENTRY", labelBg)
        f_cell(dash, 1, 5, f_price(displayEntry), panelBg)
        f_cell(dash, 0, 6, "STOP", labelBg)
        f_cell(dash, 1, 6, f_price(displayStop), panelBg)
        f_cell(dash, 0, 7, "TARGET", labelBg)
        f_cell(dash, 1, 7, f_price(displayTarget), panelBg)
        f_cell(dash, 0, 8, "LAST " + str.tostring(auditWindow), labelBg)
        f_cell(dash, 1, 8, str.tostring(currTrades) + " CLOSED", panelBg)
        f_cell(dash, 0, 9, "WIN RATE", labelBg)
        f_cell(dash, 1, 9, f_pct(currWinRate), panelBg)
        f_cell(dash, 0, 10, "EXPECTANCY", labelBg)
        f_cell(dash, 1, 10, f_r(currExpectancy), panelBg)
        f_cell(dash, 0, 11, "PROFIT FACTOR", labelBg)
        f_cell(dash, 1, 11, f_pf(currPF), panelBg)
        f_cell(dash, 0, 12, "MAX DD", labelBg)
        f_cell(dash, 1, 12, f_r(currMaxDD), panelBg)
        f_cell(dash, 0, 13, "INTRADAY WR", labelBg)
        f_cell(dash, 1, 13, f_pct(intradayWinRate), panelBg)
        f_cell(dash, 0, 14, "SCALPING WR", labelBg)
        f_cell(dash, 1, 14, f_pct(scalpingWinRate), panelBg)
        f_cell(dash, 0, 15, "AUDIT", labelBg)
        f_cell(dash, 1, 15, auditStatus, auditBg)
    else
        table.clear(dash, 0, 0, 1, 15)
