//@version=6
strategy("CASIO XAUUSD v3 BACKTEST — Visual BUY/SELL", overlay=true, pyramiding=0, process_orders_on_close=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, max_labels_count=500, max_lines_count=500, max_bars_back=5000)

// CASIO v3 BACKTEST — visual-first historical trade inspection.
// M15 = decision timeframe. M5 = extra context only for Intraday;
// existing M5 confirmation remains mandatory for Scalping.
// Recommended chart: XAUUSD M15.

// ─────────────────────────────────────────────────────────────────────────────
// Display
// ─────────────────────────────────────────────────────────────────────────────
groupDisplay = "Backtest Display"
showBuySell = input.bool(true, "Show large BUY / SELL labels", group=groupDisplay)
showExitLabels = input.bool(true, "Show WIN / LOSS labels", group=groupDisplay)
showEntryDetails = input.bool(false, "Show detailed entry information", group=groupDisplay)
showTradeLevels = input.bool(false, "Show Entry / SL / TP lines", group=groupDisplay)
showMAs = input.bool(false, "Show M15 EMA20 / EMA50", group=groupDisplay)
showRange = input.bool(false, "Show range high / low in Scalping mode", group=groupDisplay)
showDashboard = input.bool(true, "Show compact backtest dashboard", group=groupDisplay)

// Optional date filter
groupDate = "Backtest Window"
useDateFilter = input.bool(false, "Limit backtest to date range", group=groupDate)
startTime = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Start", group=groupDate)
endTime = input.time(timestamp("31 Dec 2030 23:59 +0000"), "End", group=groupDate)
inDateRange = not useDateFilter or (time >= startTime and time <= endTime)

// ─────────────────────────────────────────────────────────────────────────────
// Same v3 parameters as live FAST
// ─────────────────────────────────────────────────────────────────────────────
groupMode = "Mode"
modeInput = input.string("AUTO", "Strategy mode", options=["AUTO", "INTRADAY", "SCALPING"], group=groupMode)

groupIntraday = "Intraday MTF"
intradayMinScore = input.int(80, "Primary-session minimum score", minval=50, maxval=100, group=groupIntraday)
intradayTargetRR = input.float(3.0, "Preferred target R:R", minval=2.5, step=0.1, group=groupIntraday)
intradayMinRR = input.float(2.5, "Primary-session minimum usable R:R", minval=1.5, step=0.1, group=groupIntraday)
h1ValueAtr = input.float(0.65, "H1 value-zone distance (ATR)", minval=0.1, step=0.05, group=groupIntraday)
sweepFreshBars = input.int(3, "M15 sweep remains valid (bars)", minval=0, maxval=6, group=groupIntraday)

groupSession = "Session-Aware 24H (UTC)"
sessionPolicy = input.string("ADAPTIVE_24H", "Intraday session policy", options=["ADAPTIVE_24H", "PRIMARY_ONLY"], group=groupSession)
asiaSession = input.session("0000-0600", "Asia window", group=groupSession)
londonSession = input.session("0700-1100", "London primary window", group=groupSession)
newYorkSession = input.session("1230-1630", "New York primary window", group=groupSession)
asiaIntradayMinScore = input.int(90, "Asia trend-exception minimum score", minval=70, maxval=100, group=groupSession)
asiaIntradayMinRR = input.float(3.0, "Asia trend-exception minimum R:R", minval=2.0, step=0.1, group=groupSession)
transitionIntradayMinScore = input.int(90, "Transition trend-exception minimum score", minval=70, maxval=100, group=groupSession)
transitionIntradayMinRR = input.float(3.0, "Transition trend-exception minimum R:R", minval=2.0, step=0.1, group=groupSession)
transitionMinAdx = input.float(25.0, "Transition minimum M15 ADX", minval=10.0, step=0.5, group=groupSession)

groupScalp = "Scalping / Range"
scalpMinScore = input.int(85, "Minimum setup score", minval=50, maxval=100, group=groupScalp)
scalpMinRR = input.float(1.3, "Minimum R:R to range mean", minval=0.8, step=0.1, group=groupScalp)
h1CompressionAtr = input.float(0.40, "H1 EMA compression / ATR", minval=0.1, step=0.05, group=groupScalp)
h1MaxRangeAtr = input.float(8.0, "Maximum H1 20-bar range / ATR", minval=2.0, step=0.5, group=groupScalp)
m15MaxAdx = input.float(22.0, "Maximum M15 ADX", minval=5, step=0.5, group=groupScalp)
m15MaxRangeAtr = input.float(5.5, "Maximum M15 30-bar range / ATR", minval=2.0, step=0.1, group=groupScalp)

groupPerf = "Backtest History"
h4CalcBars = input.int(1500, "H4 bars requested", minval=100, maxval=5000, group=groupPerf)
h1CalcBars = input.int(3000, "H1 bars requested", minval=100, maxval=10000, group=groupPerf)
m5CalcBars = input.int(10000, "M5 bars requested", minval=300, maxval=50000, group=groupPerf)
signalCooldownBars = input.int(4, "Minimum M15 bars between entries", minval=1, maxval=24, group=groupPerf)

// ─────────────────────────────────────────────────────────────────────────────
// Native M15 features
// ─────────────────────────────────────────────────────────────────────────────
chartIsM15 = timeframe.isminutes and timeframe.multiplier == 15
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
atr14 = ta.atr(14)
[plusDI, minusDI, adx14] = ta.dmi(14, 14)

hh20 = ta.highest(high[1], 20)
ll20 = ta.lowest(low[1], 20)
priorHigh5 = ta.highest(high[1], 5)
priorLow5 = ta.lowest(low[1], 5)
rangeHigh30 = ta.highest(high[1], 30)
rangeLow30 = ta.lowest(low[1], 30)
rangeSize30 = rangeHigh30 - rangeLow30
rangeAtr30 = atr14 > 0 ? rangeSize30 / atr14 : na
rangeMean30 = (rangeHigh30 + rangeLow30) / 2.0

m15SellSweepRaw = low < ll20 and close > ll20
m15BuySweepRaw = high > hh20 and close < hh20
sellSweepAgo = ta.barssince(m15SellSweepRaw)
buySweepAgo = ta.barssince(m15BuySweepRaw)
recentSellSweep = not na(sellSweepAgo) and sellSweepAgo <= sweepFreshBars
recentBuySweep = not na(buySweepAgo) and buySweepAgo <= sweepFreshBars
m15BosLong = close > priorHigh5 and close > open
m15BosShort = close < priorLow5 and close < open

// ─────────────────────────────────────────────────────────────────────────────
// MTF context — mirrors v3 FAST
// ─────────────────────────────────────────────────────────────────────────────
[h4Close, h4Ema20, h4Ema50] = request.security(
    syminfo.tickerid, "240", [close, ta.ema(close, 20), ta.ema(close, 50)],
    lookahead=barmerge.lookahead_off, calc_bars_count=h4CalcBars)

[h1Close, h1Ema20, h1Ema50, h1Atr, h1High20, h1Low20] = request.security(
    syminfo.tickerid, "60",
    [close, ta.ema(close, 20), ta.ema(close, 50), ta.atr(14), ta.highest(high[1], 20), ta.lowest(low[1], 20)],
    lookahead=barmerge.lookahead_off, calc_bars_count=h1CalcBars)

[m5Open, m5Close, m5Ema20, m5Ema50, m5Rsi] = request.security(
    syminfo.tickerid, "5",
    [open, close, ta.ema(close, 20), ta.ema(close, 50), ta.rsi(close, 14)],
    lookahead=barmerge.lookahead_off, calc_bars_count=m5CalcBars)

h4Bull = h4Ema20 > h4Ema50 and h4Close > h4Ema20
h4Bear = h4Ema20 < h4Ema50 and h4Close < h4Ema20
h4Bias = h4Bull ? 1 : h4Bear ? -1 : 0

h1Bull = h1Ema20 > h1Ema50 and h1Close > h1Ema20
h1Bear = h1Ema20 < h1Ema50 and h1Close < h1Ema20
h1Bias = h1Bull ? 1 : h1Bear ? -1 : 0
h1LongVeto = h1Bias == -1
h1ShortVeto = h1Bias == 1

h1LongValue = close <= h1Ema20 + h1Atr * h1ValueAtr and close > h1Low20 - h1Atr * 0.20
h1ShortValue = close >= h1Ema20 - h1Atr * h1ValueAtr and close < h1High20 + h1Atr * 0.20

h1RangeSize = h1High20 - h1Low20
h1RangeAtr = h1Atr > 0 ? h1RangeSize / h1Atr : na
h1Compression = h1Atr > 0 ? math.abs(h1Ema20 - h1Ema50) / h1Atr : na
h1RangeRegime = not na(h1Compression) and not na(h1RangeAtr) and h1Compression <= h1CompressionAtr and h1RangeAtr <= h1MaxRangeAtr

m5Bull = m5Ema20 > m5Ema50 and m5Close > m5Ema20
m5Bear = m5Ema20 < m5Ema50 and m5Close < m5Ema20
m5Bias = m5Bull ? 1 : m5Bear ? -1 : 0
m5BullConfirm = m5Close > m5Open and m5Close > m5Ema20
m5BearConfirm = m5Close < m5Open and m5Close < m5Ema20
m5Trigger = m5BullConfirm ? "BULL" : m5BearConfirm ? "BEAR" : "WAIT"

m15RangeRegime = adx14 <= m15MaxAdx and rangeAtr30 <= m15MaxRangeAtr
scalpRegime = h1RangeRegime and m15RangeRegime
autoMode = scalpRegime ? "SCALPING" : "INTRADAY"
activeMode = modeInput == "AUTO" ? autoMode : modeInput

// ─────────────────────────────────────────────────────────────────────────────
// Sessions
// ─────────────────────────────────────────────────────────────────────────────
inAsia = not na(time(timeframe.period, asiaSession, "UTC"))
inLondon = not na(time(timeframe.period, londonSession, "UTC"))
inNewYork = not na(time(timeframe.period, newYorkSession, "UTC"))
inPrimarySession = inLondon or inNewYork
inTransition = not inAsia and not inPrimarySession
sessionName = inAsia ? "ASIA" : inLondon ? "LONDON" : inNewYork ? "NEW YORK" : "TRANSITION"

requiredIntradayScore = inPrimarySession ? intradayMinScore : inAsia ? asiaIntradayMinScore : transitionIntradayMinScore
requiredIntradayRR = inPrimarySession ? intradayMinRR : inAsia ? asiaIntradayMinRR : transitionIntradayMinRR
sessionBonus = inPrimarySession ? 10 : inAsia ? 5 : 0
longSessionGate = sessionPolicy == "PRIMARY_ONLY" ? inPrimarySession : (inPrimarySession or (inAsia and h1Bias == 1) or (inTransition and h1Bias == 1 and adx14 >= transitionMinAdx))
shortSessionGate = sessionPolicy == "PRIMARY_ONLY" ? inPrimarySession : (inPrimarySession or (inAsia and h1Bias == -1) or (inTransition and h1Bias == -1 and adx14 >= transitionMinAdx))

// ─────────────────────────────────────────────────────────────────────────────
// Intraday — unchanged v3; M5 is context only
// ─────────────────────────────────────────────────────────────────────────────
intradayLongStopDistance = math.max(close - (ll20 - atr14 * 0.20), atr14 * 1.00)
intradayShortStopDistance = math.max((hh20 + atr14 * 0.20) - close, atr14 * 1.00)
longLiquidityRR = intradayLongStopDistance > 0 ? (h1High20 - close) / intradayLongStopDistance : na
shortLiquidityRR = intradayShortStopDistance > 0 ? (close - h1Low20) / intradayShortStopDistance : na
longRRPass = not na(longLiquidityRR) and longLiquidityRR >= requiredIntradayRR
shortRRPass = not na(shortLiquidityRR) and shortLiquidityRR >= requiredIntradayRR

intradayLongScore = 0
intradayLongScore += h4Bias == 1 ? 20 : 0
intradayLongScore += h1Bias == 1 ? 15 : h1Bias == 0 ? 8 : 0
intradayLongScore += h1LongValue ? 15 : 0
intradayLongScore += recentSellSweep ? 20 : 0
intradayLongScore += m15BosLong ? 15 : 0
intradayLongScore += sessionBonus
intradayLongScore += longRRPass ? 5 : 0

intradayShortScore = 0
intradayShortScore += h4Bias == -1 ? 20 : 0
intradayShortScore += h1Bias == -1 ? 15 : h1Bias == 0 ? 8 : 0
intradayShortScore += h1ShortValue ? 15 : 0
intradayShortScore += recentBuySweep ? 20 : 0
intradayShortScore += m15BosShort ? 15 : 0
intradayShortScore += sessionBonus
intradayShortScore += shortRRPass ? 5 : 0

intradayLongMandatory = chartIsM15 and activeMode == "INTRADAY" and h4Bias == 1 and not h1LongVeto and h1LongValue and recentSellSweep and m15BosLong and longSessionGate and longRRPass
intradayShortMandatory = chartIsM15 and activeMode == "INTRADAY" and h4Bias == -1 and not h1ShortVeto and h1ShortValue and recentBuySweep and m15BosShort and shortSessionGate and shortRRPass
intradayLongValid = intradayLongMandatory and intradayLongScore >= requiredIntradayScore
intradayShortValid = intradayShortMandatory and intradayShortScore >= requiredIntradayScore

intradayDirection = intradayLongValid ? 1 : intradayShortValid ? -1 : 0
intradayScore = intradayDirection == 1 ? intradayLongScore : intradayDirection == -1 ? intradayShortScore : math.max(intradayLongScore, intradayShortScore)
intradayStopDistance = intradayDirection == 1 ? intradayLongStopDistance : intradayDirection == -1 ? intradayShortStopDistance : na
intradayLiquidityTarget = intradayDirection == 1 ? h1High20 : intradayDirection == -1 ? h1Low20 : na
intradayPreferredTarget = intradayDirection == 1 ? close + intradayStopDistance * intradayTargetRR : intradayDirection == -1 ? close - intradayStopDistance * intradayTargetRR : na
intradayTarget = intradayDirection == 1 ? math.min(intradayPreferredTarget, intradayLiquidityTarget) : intradayDirection == -1 ? math.max(intradayPreferredTarget, intradayLiquidityTarget) : na
intradayActualRR = intradayDirection == 1 ? (intradayTarget - close) / intradayStopDistance : intradayDirection == -1 ? (close - intradayTarget) / intradayStopDistance : na

// ─────────────────────────────────────────────────────────────────────────────
// Scalping — unchanged v3; M5 confirmation remains mandatory
// ─────────────────────────────────────────────────────────────────────────────
scalpLongSweep = low < rangeLow30 and close > rangeLow30
scalpShortSweep = high > rangeHigh30 and close < rangeHigh30
scalpLongStopDistance = math.max(close - (low - atr14 * 0.10), atr14 * 0.65)
scalpShortStopDistance = math.max((high + atr14 * 0.10) - close, atr14 * 0.65)
scalpLongRR = scalpLongStopDistance > 0 ? (rangeMean30 - close) / scalpLongStopDistance : na
scalpShortRR = scalpShortStopDistance > 0 ? (close - rangeMean30) / scalpShortStopDistance : na
scalpLongRRPass = not na(scalpLongRR) and scalpLongRR >= scalpMinRR
scalpShortRRPass = not na(scalpShortRR) and scalpShortRR >= scalpMinRR

scalpLongScore = (h1RangeRegime ? 25 : 0) + (m15RangeRegime ? 20 : 0) + (scalpLongSweep ? 25 : 0) + (m5BullConfirm ? 15 : 0) + (scalpLongRRPass ? 15 : 0)
scalpShortScore = (h1RangeRegime ? 25 : 0) + (m15RangeRegime ? 20 : 0) + (scalpShortSweep ? 25 : 0) + (m5BearConfirm ? 15 : 0) + (scalpShortRRPass ? 15 : 0)
scalpLongValid = chartIsM15 and activeMode == "SCALPING" and scalpRegime and scalpLongSweep and m5BullConfirm and scalpLongRRPass and scalpLongScore >= scalpMinScore
scalpShortValid = chartIsM15 and activeMode == "SCALPING" and scalpRegime and scalpShortSweep and m5BearConfirm and scalpShortRRPass and scalpShortScore >= scalpMinScore

scalpDirection = scalpLongValid ? 1 : scalpShortValid ? -1 : 0
scalpScore = scalpDirection == 1 ? scalpLongScore : scalpDirection == -1 ? scalpShortScore : math.max(scalpLongScore, scalpShortScore)
scalpStopDistance = scalpDirection == 1 ? scalpLongStopDistance : scalpDirection == -1 ? scalpShortStopDistance : na
scalpActualRR = scalpDirection == 1 ? scalpLongRR : scalpDirection == -1 ? scalpShortRR : na
scalpTarget = scalpDirection != 0 ? rangeMean30 : na

// ─────────────────────────────────────────────────────────────────────────────
// Unified signal
// ─────────────────────────────────────────────────────────────────────────────
signalValid = intradayDirection != 0 or scalpDirection != 0
signalDirection = intradayDirection != 0 ? intradayDirection : scalpDirection
signalScore = intradayDirection != 0 ? intradayScore : scalpDirection != 0 ? scalpScore : activeMode == "INTRADAY" ? intradayScore : scalpScore
signalRR = intradayDirection != 0 ? intradayActualRR : scalpDirection != 0 ? scalpActualRR : na
signalEntry = signalValid ? close : na
signalStopDistance = intradayDirection != 0 ? intradayStopDistance : scalpDirection != 0 ? scalpStopDistance : na
signalStop = signalDirection == 1 ? signalEntry - signalStopDistance : signalDirection == -1 ? signalEntry + signalStopDistance : na
signalTarget = intradayDirection != 0 ? intradayTarget : scalpDirection != 0 ? scalpTarget : na

f_bias(v) => v == 1 ? "BULL" : v == -1 ? "BEAR" : "NEUTRAL"
f_num(v) => na(v) ? "—" : str.tostring(v, format.mintick)
f_rr(v) => na(v) ? "—" : "1:" + str.tostring(v, "#.##")

// ─────────────────────────────────────────────────────────────────────────────
// Execute and mark actual historical trades
// ─────────────────────────────────────────────────────────────────────────────
var int lastEntryBar = na
var int rawSignalCount = 0
var int executedCount = 0
var float activeEntry = na
var float activeStop = na
var float activeTarget = na
var float activeRR = na
var string activeModeAtEntry = ""
var string activeSessionAtEntry = ""
var string activeM5AtEntry = ""
var line activeEntryLine = na
var line activeStopLine = na
var line activeTargetLine = na
var float cumulativeR = 0.0
var int seenClosedTrades = 0

if barstate.isconfirmed and chartIsM15 and inDateRange and signalValid
    rawSignalCount += 1

cooldownReady = na(lastEntryBar) or bar_index - lastEntryBar >= signalCooldownBars
canEnter = barstate.isconfirmed and chartIsM15 and inDateRange and signalValid and strategy.position_size == 0 and cooldownReady and not na(signalStop) and not na(signalTarget) and not na(signalRR) and signalRR > 0

if canEnter
    lastEntryBar := bar_index
    executedCount += 1
    activeEntry := signalEntry
    activeStop := signalStop
    activeTarget := signalTarget
    activeRR := signalRR
    activeModeAtEntry := activeMode
    activeSessionAtEntry := sessionName
    activeM5AtEntry := f_bias(m5Bias) + " • RSI " + str.tostring(m5Rsi, "#.0") + " • " + m5Trigger

    if signalDirection == 1
        strategy.entry("LONG", strategy.long)
        strategy.exit("LONG EXIT", "LONG", stop=activeStop, limit=activeTarget)
    else
        strategy.entry("SHORT", strategy.short)
        strategy.exit("SHORT EXIT", "SHORT", stop=activeStop, limit=activeTarget)

    // These labels are intentionally large and independent of TradingView's
    // built-in strategy order markers so they remain obvious on mobile.
    if showBuySell
        label.new(
          bar_index,
          signalDirection == 1 ? low - atr14 * 0.20 : high + atr14 * 0.20,
          signalDirection == 1 ? "BUY" : "SELL",
          style=signalDirection == 1 ? label.style_label_up : label.style_label_down,
          color=signalDirection == 1 ? color.green : color.red,
          textcolor=color.white,
          size=size.large)

    if showEntryDetails
        label.new(
          bar_index,
          signalDirection == 1 ? low - atr14 * 0.65 : high + atr14 * 0.65,
          (signalDirection == 1 ? "LONG" : "SHORT") + " • " + activeMode + "\n" +
          activeSessionAtEntry + " • Score " + str.tostring(signalScore) + "\n" +
          "H4/H1 " + f_bias(h4Bias) + "/" + f_bias(h1Bias) + "\n" +
          "M5 " + activeM5AtEntry + "\n" +
          "Entry " + f_num(activeEntry) + "\nSL " + f_num(activeStop) + " • TP " + f_num(activeTarget) + "\n" +
          "R:R " + f_rr(activeRR),
          style=signalDirection == 1 ? label.style_label_up : label.style_label_down,
          color=color.new(signalDirection == 1 ? color.green : color.red, 15),
          textcolor=color.white,
          size=size.small)

    if showTradeLevels
        activeEntryLine := line.new(bar_index, activeEntry, bar_index + 1, activeEntry, extend=extend.right, color=color.aqua, width=1)
        activeStopLine := line.new(bar_index, activeStop, bar_index + 1, activeStop, extend=extend.right, color=color.red, width=1)
        activeTargetLine := line.new(bar_index, activeTarget, bar_index + 1, activeTarget, extend=extend.right, color=color.green, width=1)

if strategy.position_size > 0 and not na(activeStop) and not na(activeTarget)
    strategy.exit("LONG EXIT", "LONG", stop=activeStop, limit=activeTarget)
if strategy.position_size < 0 and not na(activeStop) and not na(activeTarget)
    strategy.exit("SHORT EXIT", "SHORT", stop=activeStop, limit=activeTarget)

if strategy.closedtrades > seenClosedTrades
    int t = strategy.closedtrades - 1
    float exitPrice = strategy.closedtrades.exit_price(t)
    int exitBar = strategy.closedtrades.exit_bar_index(t)
    float p = strategy.closedtrades.profit(t)
    bool won = p > 0
    cumulativeR += won ? activeRR : -1.0

    if showTradeLevels
        if not na(activeEntryLine)
            line.set_x2(activeEntryLine, exitBar)
            line.set_extend(activeEntryLine, extend.none)
        if not na(activeStopLine)
            line.set_x2(activeStopLine, exitBar)
            line.set_extend(activeStopLine, extend.none)
        if not na(activeTargetLine)
            line.set_x2(activeTargetLine, exitBar)
            line.set_extend(activeTargetLine, extend.none)

    if showExitLabels
        label.new(
          exitBar,
          exitPrice,
          won ? "WIN\n+" + str.tostring(activeRR, "#.##") + "R" : "LOSS\n-1R",
          style=won ? label.style_label_up : label.style_label_down,
          color=won ? color.green : color.red,
          textcolor=color.white,
          size=size.large)

    seenClosedTrades := strategy.closedtrades
    activeEntry := na
    activeStop := na
    activeTarget := na
    activeRR := na
    activeModeAtEntry := ""
    activeSessionAtEntry := ""
    activeM5AtEntry := ""
    activeEntryLine := na
    activeStopLine := na
    activeTargetLine := na

// ─────────────────────────────────────────────────────────────────────────────
// Optional chart context — OFF by default so trades are the focus.
// ─────────────────────────────────────────────────────────────────────────────
plot(showMAs ? ema20 : na, "M15 EMA20", linewidth=1)
plot(showMAs ? ema50 : na, "M15 EMA50", linewidth=1)
plot(showRange and activeMode == "SCALPING" ? rangeHigh30 : na, "Range high", style=plot.style_linebr)
plot(showRange and activeMode == "SCALPING" ? rangeLow30 : na, "Range low", style=plot.style_linebr)

// ─────────────────────────────────────────────────────────────────────────────
// Compact dashboard
// ─────────────────────────────────────────────────────────────────────────────
panelBg = color.new(color.rgb(15, 18, 25), 8)
labelBg = color.new(color.rgb(29, 34, 45), 5)
headerBg = color.new(color.rgb(8, 10, 14), 0)
f_cell(tbl, col, row, txt, bg) => table.cell(tbl, col, row, txt, text_color=color.white, bgcolor=bg, text_size=size.small)

var table dash = table.new(position.bottom_left, 2, 9, bgcolor=panelBg, frame_color=color.new(color.white, 55), frame_width=1)
if barstate.islast
    if showDashboard
        float wr = strategy.closedtrades > 0 ? strategy.wintrades * 100.0 / strategy.closedtrades : na
        f_cell(dash, 0, 0, "CASIO v3 BT", headerBg)
        f_cell(dash, 1, 0, chartIsM15 ? "M15 READY" : "USE M15", headerBg)
        f_cell(dash, 0, 1, "MODE", labelBg)
        f_cell(dash, 1, 1, activeMode, panelBg)
        f_cell(dash, 0, 2, "RAW SIGNALS", labelBg)
        f_cell(dash, 1, 2, str.tostring(rawSignalCount), panelBg)
        f_cell(dash, 0, 3, "EXECUTED", labelBg)
        f_cell(dash, 1, 3, str.tostring(executedCount), panelBg)
        f_cell(dash, 0, 4, "CLOSED", labelBg)
        f_cell(dash, 1, 4, str.tostring(strategy.closedtrades), panelBg)
        f_cell(dash, 0, 5, "W / L", labelBg)
        f_cell(dash, 1, 5, str.tostring(strategy.wintrades) + " / " + str.tostring(strategy.losstrades), panelBg)
        f_cell(dash, 0, 6, "WIN RATE", labelBg)
        f_cell(dash, 1, 6, na(wr) ? "—" : str.tostring(wr, "#.1") + "%", panelBg)
        f_cell(dash, 0, 7, "NET R", labelBg)
        f_cell(dash, 1, 7, str.tostring(cumulativeR, "#.##") + "R", panelBg)
        f_cell(dash, 0, 8, "M5 NOW", labelBg)
        f_cell(dash, 1, 8, f_bias(m5Bias) + " • " + m5Trigger, panelBg)
    else
        table.clear(dash, 0, 0, 1, 8)
