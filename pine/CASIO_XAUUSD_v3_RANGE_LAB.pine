//@version=6
strategy("CASIO XAUUSD v3 RANGE LAB — Sideways Backtest", overlay=true, pyramiding=0, process_orders_on_close=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, max_labels_count=500, max_bars_back=5000)

// CASIO v3 RANGE LAB
// Research-only strategy for diagnosing the low-frequency sideways/range engine.
// It does NOT change the production v3 FAST or Python live signal rules.
// Recommended chart: XAUUSD M15.

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
groupModel = "Range Setup Model"
setupModel = input.string("DUAL", "Setup model", options=["STRICT_SWEEP", "EDGE_REJECTION", "DUAL"], group=groupModel)
showLabels = input.bool(true, "Show setup labels", group=groupModel)
showRange = input.bool(true, "Show 30-bar range + mean", group=groupModel)
edgeZonePct = input.float(0.18, "Edge zone (% of range)", minval=0.05, maxval=0.40, step=0.01, group=groupModel)
edgeClosePct = input.float(0.55, "Rejection close position", minval=0.50, maxval=0.90, step=0.05, group=groupModel)

// Preserve current CASIO v3 range-regime thresholds by default.
groupRegime = "Range Regime"
h1CompressionAtr = input.float(0.40, "H1 EMA compression / ATR", minval=0.1, step=0.05, group=groupRegime)
h1MaxRangeAtr = input.float(8.0, "Maximum H1 20-bar range / ATR", minval=2.0, step=0.5, group=groupRegime)
m15MaxAdx = input.float(22.0, "Maximum M15 ADX", minval=5.0, step=0.5, group=groupRegime)
m15MaxRangeAtr = input.float(5.5, "Maximum M15 30-bar range / ATR", minval=2.0, step=0.1, group=groupRegime)

// Execution
groupExec = "Execution"
minRR = input.float(1.30, "Minimum R:R to range mean", minval=0.5, step=0.05, group=groupExec)
stopAtrBuffer = input.float(0.10, "Stop buffer ATR", minval=0.0, step=0.05, group=groupExec)
minStopAtr = input.float(0.65, "Minimum stop distance ATR", minval=0.2, step=0.05, group=groupExec)
useM5Confirmation = input.bool(true, "Require M5 confirmation", group=groupExec)
cooldownBars = input.int(4, "Minimum M15 bars between entries", minval=1, maxval=24, group=groupExec)

// Optional date filter
groupDate = "Backtest Window"
useDateFilter = input.bool(false, "Limit backtest to date range", group=groupDate)
startTime = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Start", group=groupDate)
endTime = input.time(timestamp("31 Dec 2030 23:59 +0000"), "End", group=groupDate)
inDateRange = not useDateFilter or (time >= startTime and time <= endTime)

// ─────────────────────────────────────────────────────────────────────────────
// Native M15 features
// ─────────────────────────────────────────────────────────────────────────────
chartIsM15 = timeframe.isminutes and timeframe.multiplier == 15
atr14 = ta.atr(14)
[plusDI, minusDI, adx14] = ta.dmi(14, 14)

rangeHigh30 = ta.highest(high[1], 30)
rangeLow30 = ta.lowest(low[1], 30)
rangeSize30 = rangeHigh30 - rangeLow30
rangeMean30 = (rangeHigh30 + rangeLow30) / 2.0
rangeAtr30 = atr14 > 0 ? rangeSize30 / atr14 : na

// ─────────────────────────────────────────────────────────────────────────────
// H1 + M5 state, same family as current CASIO v3
// ─────────────────────────────────────────────────────────────────────────────
[h1Ema20, h1Ema50, h1Atr, h1High20, h1Low20] = request.security(
    syminfo.tickerid,
    "60",
    [ta.ema(close, 20), ta.ema(close, 50), ta.atr(14), ta.highest(high[1], 20), ta.lowest(low[1], 20)],
    lookahead=barmerge.lookahead_off,
    calc_bars_count=3000)

[m5Open, m5Close, m5Ema20] = request.security(
    syminfo.tickerid,
    "5",
    [open, close, ta.ema(close, 20)],
    lookahead=barmerge.lookahead_off,
    calc_bars_count=10000)

h1RangeSize = h1High20 - h1Low20
h1RangeAtr = h1Atr > 0 ? h1RangeSize / h1Atr : na
h1Compression = h1Atr > 0 ? math.abs(h1Ema20 - h1Ema50) / h1Atr : na
h1RangeRegime = not na(h1Compression) and not na(h1RangeAtr) and h1Compression <= h1CompressionAtr and h1RangeAtr <= h1MaxRangeAtr
m15RangeRegime = not na(adx14) and not na(rangeAtr30) and adx14 <= m15MaxAdx and rangeAtr30 <= m15MaxRangeAtr
rangeRegime = h1RangeRegime and m15RangeRegime

m5BullConfirm = m5Close > m5Open and m5Close > m5Ema20
m5BearConfirm = m5Close < m5Open and m5Close < m5Ema20
m5LongOK = not useM5Confirmation or m5BullConfirm
m5ShortOK = not useM5Confirmation or m5BearConfirm

// ─────────────────────────────────────────────────────────────────────────────
// Two sideways playbooks
// 1) STRICT_SWEEP = original CASIO failed-breakout/reclaim model.
// 2) EDGE_REJECTION = price rotates from an edge zone without requiring a new
//    30-bar extreme. This is the missing behavior seen in visual backtests.
// ─────────────────────────────────────────────────────────────────────────────
strictLong = low < rangeLow30 and close > rangeLow30
strictShort = high > rangeHigh30 and close < rangeHigh30

lowerEdge = rangeLow30 + rangeSize30 * edgeZonePct
upperEdge = rangeHigh30 - rangeSize30 * edgeZonePct
candleRange = math.max(high - low, syminfo.mintick)
longClosePosition = (close - low) / candleRange
shortClosePosition = (high - close) / candleRange

edgeLong = low <= lowerEdge and close < rangeMean30 and close > open and longClosePosition >= edgeClosePct
edgeShort = high >= upperEdge and close > rangeMean30 and close < open and shortClosePosition >= edgeClosePct

longSetupRaw = setupModel == "STRICT_SWEEP" ? strictLong : setupModel == "EDGE_REJECTION" ? edgeLong : (strictLong or edgeLong)
shortSetupRaw = setupModel == "STRICT_SWEEP" ? strictShort : setupModel == "EDGE_REJECTION" ? edgeShort : (strictShort or edgeShort)

longSetupType = strictLong ? "SWEEP" : "EDGE"
shortSetupType = strictShort ? "SWEEP" : "EDGE"

// ─────────────────────────────────────────────────────────────────────────────
// Stops, target and R:R
// ─────────────────────────────────────────────────────────────────────────────
longStopDistance = math.max(close - (low - atr14 * stopAtrBuffer), atr14 * minStopAtr)
shortStopDistance = math.max((high + atr14 * stopAtrBuffer) - close, atr14 * minStopAtr)
longRR = longStopDistance > 0 ? (rangeMean30 - close) / longStopDistance : na
shortRR = shortStopDistance > 0 ? (close - rangeMean30) / shortStopDistance : na

longValid = chartIsM15 and inDateRange and rangeRegime and longSetupRaw and m5LongOK and not na(longRR) and longRR >= minRR
shortValid = chartIsM15 and inDateRange and rangeRegime and shortSetupRaw and m5ShortOK and not na(shortRR) and shortRR >= minRR

// ─────────────────────────────────────────────────────────────────────────────
// Orders — one range trade at a time
// ─────────────────────────────────────────────────────────────────────────────
var int lastEntryBar = na
var float activeEntry = na
var float activeStop = na
var float activeTarget = na
var float activeRR = na

cooldownReady = na(lastEntryBar) or bar_index - lastEntryBar >= cooldownBars
canEnter = barstate.isconfirmed and strategy.position_size == 0 and cooldownReady and (longValid or shortValid)

if canEnter
    bool goLong = longValid and not shortValid
    bool goShort = shortValid and not longValid

    if goLong
        lastEntryBar := bar_index
        activeEntry := close
        activeStop := close - longStopDistance
        activeTarget := rangeMean30
        activeRR := longRR
        strategy.entry("RANGE LONG", strategy.long)
        strategy.exit("RANGE LONG EXIT", "RANGE LONG", stop=activeStop, limit=activeTarget)
        if showLabels
            label.new(bar_index, low,
              "RANGE LONG • " + longSetupType + "\n" +
              "ADX " + str.tostring(adx14, "#.0") + " • RR 1:" + str.tostring(longRR, "#.##") + "\n" +
              "Entry " + str.tostring(close, format.mintick) + " • Mean " + str.tostring(rangeMean30, format.mintick),
              style=label.style_label_up, color=color.new(color.green, 10), textcolor=color.white, size=size.tiny)

    if goShort
        lastEntryBar := bar_index
        activeEntry := close
        activeStop := close + shortStopDistance
        activeTarget := rangeMean30
        activeRR := shortRR
        strategy.entry("RANGE SHORT", strategy.short)
        strategy.exit("RANGE SHORT EXIT", "RANGE SHORT", stop=activeStop, limit=activeTarget)
        if showLabels
            label.new(bar_index, high,
              "RANGE SHORT • " + shortSetupType + "\n" +
              "ADX " + str.tostring(adx14, "#.0") + " • RR 1:" + str.tostring(shortRR, "#.##") + "\n" +
              "Entry " + str.tostring(close, format.mintick) + " • Mean " + str.tostring(rangeMean30, format.mintick),
              style=label.style_label_down, color=color.new(color.red, 10), textcolor=color.white, size=size.tiny)

if strategy.position_size > 0 and not na(activeStop) and not na(activeTarget)
    strategy.exit("RANGE LONG EXIT", "RANGE LONG", stop=activeStop, limit=activeTarget)
if strategy.position_size < 0 and not na(activeStop) and not na(activeTarget)
    strategy.exit("RANGE SHORT EXIT", "RANGE SHORT", stop=activeStop, limit=activeTarget)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    activeEntry := na
    activeStop := na
    activeTarget := na
    activeRR := na

// ─────────────────────────────────────────────────────────────────────────────
// Visuals + compact diagnostics
// ─────────────────────────────────────────────────────────────────────────────
plot(showRange and rangeRegime ? rangeHigh30 : na, "Range high", style=plot.style_linebr)
plot(showRange and rangeRegime ? rangeLow30 : na, "Range low", style=plot.style_linebr)
plot(showRange and rangeRegime ? rangeMean30 : na, "Range mean", style=plot.style_linebr)
plot(showRange and rangeRegime ? lowerEdge : na, "Lower edge zone", style=plot.style_linebr)
plot(showRange and rangeRegime ? upperEdge : na, "Upper edge zone", style=plot.style_linebr)
plot(showRange and not na(activeStop) ? activeStop : na, "Active stop", style=plot.style_linebr, linewidth=2)
plot(showRange and not na(activeTarget) ? activeTarget : na, "Active target", style=plot.style_linebr, linewidth=2)

panelBg = color.new(color.rgb(15, 18, 25), 5)
labelBg = color.new(color.rgb(29, 34, 45), 2)
var table dash = table.new(position.top_right, 2, 7, bgcolor=panelBg, frame_color=color.new(color.white, 55), frame_width=1)
f_cell(tbl, col, row, txt, bg) => table.cell(tbl, col, row, txt, text_color=color.white, bgcolor=bg, text_size=size.small)

if barstate.islast
    f_cell(dash, 0, 0, "CASIO RANGE LAB", color.new(color.black, 0))
    f_cell(dash, 1, 0, setupModel, color.new(color.black, 0))
    f_cell(dash, 0, 1, "RANGE REGIME", labelBg)
    f_cell(dash, 1, 1, rangeRegime ? "YES" : "NO", panelBg)
    f_cell(dash, 0, 2, "H1 COMP", labelBg)
    f_cell(dash, 1, 2, str.tostring(h1Compression, "#.##"), panelBg)
    f_cell(dash, 0, 3, "M15 ADX", labelBg)
    f_cell(dash, 1, 3, str.tostring(adx14, "#.##"), panelBg)
    f_cell(dash, 0, 4, "CLOSED", labelBg)
    f_cell(dash, 1, 4, str.tostring(strategy.closedtrades), panelBg)
    f_cell(dash, 0, 5, "W / L", labelBg)
    f_cell(dash, 1, 5, str.tostring(strategy.wintrades) + " / " + str.tostring(strategy.losstrades), panelBg)
    float wr = strategy.closedtrades > 0 ? strategy.wintrades * 100.0 / strategy.closedtrades : na
    f_cell(dash, 0, 6, "WIN RATE", labelBg)
    f_cell(dash, 1, 6, na(wr) ? "—" : str.tostring(wr, "#.0") + "%", panelBg)
