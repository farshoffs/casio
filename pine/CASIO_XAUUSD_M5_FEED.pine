//@version=6
indicator("CASIO XAUUSD M5 DATA FEED", overlay=false, max_bars_back=20)

// Realtime-only market-data collector for CASIO v3 research.
// Run on the SAME XAUUSD feed you use for CASIO, on a 5-minute chart.
// Create one TradingView alert using: Any alert() function call.
// TradingView will then send every newly closed M5 bar to the CASIO Vercel webhook.
// This does NOT backfill historical bars. It continuously collects future bars after the alert is created.

groupFeed = "CASIO M5 Feed"
sendBars = input.bool(true, "Send each closed M5 bar", group=groupFeed)
showStatus = input.bool(true, "Show status panel", group=groupFeed)

isM5 = timeframe.isminutes and timeframe.multiplier == 5
isXau = str.contains(str.upper(syminfo.ticker), "XAUUSD") or str.contains(str.upper(syminfo.tickerid), "XAUUSD")
feedReady = isM5 and isXau

f_num(v) => str.tostring(v, format.mintick)
f_volume(v) => na(v) ? "0" : str.tostring(v, "#.####")

if barstate.isconfirmed and feedReady and sendBars
    payload = "{" +
      "\"schema\":\"casio.market.v1\"," +
      "\"event\":\"bar\"," +
      "\"symbol\":\"" + syminfo.tickerid + "\"," +
      "\"ticker\":\"" + syminfo.ticker + "\"," +
      "\"timeframe\":\"5\"," +
      "\"bar_time\":" + str.tostring(time) + "," +
      "\"open\":" + f_num(open) + "," +
      "\"high\":" + f_num(high) + "," +
      "\"low\":" + f_num(low) + "," +
      "\"close\":" + f_num(close) + "," +
      "\"volume\":" + f_volume(volume) +
      "}"
    alert(payload, alert.freq_once_per_bar_close)

panelBg = color.new(color.rgb(15, 18, 25), 4)
labelBg = color.new(color.rgb(29, 34, 45), 2)
headerBg = color.new(color.rgb(8, 10, 14), 0)
readyBg = feedReady and sendBars ? color.new(color.green, 75) : color.new(color.red, 65)

f_cell(tbl, col, row, txt, bg) =>
    table.cell(tbl, col, row, txt, text_color=color.white, bgcolor=bg, text_size=size.small)

var table status = table.new(position.top_right, 2, 6, bgcolor=panelBg, frame_color=color.new(color.white, 55), frame_width=1)
if barstate.islast
    if showStatus
        f_cell(status, 0, 0, "CASIO M5 FEED", headerBg)
        f_cell(status, 1, 0, syminfo.ticker + " • " + timeframe.period, headerBg)
        f_cell(status, 0, 1, "STATUS", labelBg)
        f_cell(status, 1, 1, feedReady and sendBars ? "COLLECTING" : "CHECK CHART", readyBg)
        f_cell(status, 0, 2, "SYMBOL", labelBg)
        f_cell(status, 1, 2, isXau ? "XAUUSD OK" : "USE XAUUSD", panelBg)
        f_cell(status, 0, 3, "TIMEFRAME", labelBg)
        f_cell(status, 1, 3, isM5 ? "M5 OK" : "USE 5m", panelBg)
        f_cell(status, 0, 4, "LAST BAR", labelBg)
        f_cell(status, 1, 4, str.format_time(time, "yyyy-MM-dd HH:mm", "UTC") + " UTC", panelBg)
        f_cell(status, 0, 5, "ACTION", labelBg)
        f_cell(status, 1, 5, "ALERT() -> VERCEL", panelBg)
    else
        table.clear(status, 0, 0, 1, 5)
